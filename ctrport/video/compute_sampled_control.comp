#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) buffer Data {uint words[];} data;
layout(set=0,binding=1) uniform texture2D pixels;
layout(push_constant) uniform Push {uint value;} push;
void main(){uint i=gl_GlobalInvocationID.x;data.words[i]=push.value+uint(round(texelFetch(pixels,ivec2(i,0),0).r*255.0));}
