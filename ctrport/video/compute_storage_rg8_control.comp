#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Data {uint words[];} data;
layout(set=0,binding=1,rg8) uniform writeonly image2D pixels;
layout(push_constant) uniform Push {uint value;} push;
void main(){uvec2 p=gl_GlobalInvocationID.xy;imageStore(pixels,ivec2(p),vec4(p.x&255,p.y&255,(push.value+data.words[(p.x+p.y)&3])&255,255)/255.0);}
